{
  "name": "bharatyatra-pwa",
  "version": "1.0.0",
  "description": "BharatYatra PWA — Offline-First EMI-Based Bus Tour & Micro-Collection System",
  "type": "module",
  "scripts": {
    "start": "./pocketbase serve --http=0.0.0.0:8090",
    "test": "node tests/phase1_verification.js",
    "pb": "pocketbase.exe serve --http=127.0.0.1:8090",
    "pb:linux": "./pocketbase serve --http=127.0.0.1:8090",
    "build": "npm run build:css",
    "build:css": "node ./node_modules/tailwindcss/lib/cli.js -i ./pb_public/css/input.css -o ./pb_public/css/tailwind.css --minify",
    "watch:css": "node ./node_modules/tailwindcss/lib/cli.js -i ./pb_public/css/input.css -o ./pb_public/css/tailwind.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "@tailwindcss/forms": "^0.5.9"
  },
  "license": "ISC"
}
